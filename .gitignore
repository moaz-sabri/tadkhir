# ---- Dependencies ----------------------------------------------------------
node_modules/

# ---- Build output ----------------------------------------------------------
# `npm run build` writes app/dist/. It is a build artifact, not source: it is
# produced on CI and verified there as a releasable artifact.
dist/
app/dist/

# ---- Server runtime data ---------------------------------------------------
# The sync database and parked share uploads. Never commit these: they contain
# ciphertext and uploaded files belonging to whoever is running the instance.
api/config.local.php
api/var/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ---- Environment and local configuration ------------------------------------
.env
.env.*
!.env.example
*.local

# ---- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
php_error.log

# ---- Editor and OS ---------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

.idea/
*.swp
*.swo

# Editors write per-machine state into these; only the shared, checked-in
# `settings.json` and `extensions.json` are meant to be in the repository.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Python bytecode (tools/make-icons.py)
__pycache__/
*.pyc

# ---- OS / package-manager noise --------------------------------------------
*.bak
*.orig