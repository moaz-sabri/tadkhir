{
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 96,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": ["*.md", "*.yml", "*.yaml", "*.json", "*.webmanifest"],
            "options": {
                "tabWidth": 2
            }
        }
    ]
}