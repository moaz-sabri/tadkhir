    // 'max_device_label_len'    => 120,
    //
    // 'hsts_max_age' => 0,   // 0 sends no Strict-Transport-Security header, which is
    //                        // what you want while the origin is plain HTTP: the header
    //                        // is cached by the browser and would break every later
    //                        // plain-HTTP request to the same host. Set it to 31536000
