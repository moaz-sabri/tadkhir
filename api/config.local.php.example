    // ---- security knobs (every one has a working default) ----
    //
    // 'password_algo'   => 'argon2id',  // argon2id | bcrypt; auto-detected when unset.
    //                                      bcrypt truncates silently at 72 bytes, so
    //                                      leave this alone unless the build has no
    //                                      libargon2.
    // 'max_password_bytes' => 1024,     // longest accepted password. A ceiling, not a
    //                                      policy: it is what makes the bcrypt fallback
    //                                      behave like argon2id instead of ignoring
    //                                      everything past byte 72.
    //
    // 'rate_max'          => 10,        // FAILED auth/open per IP per window. A
    // 'rate_max_create'   => 20,        // number of auth/open ATTEMPTS per IP per
    // 'rate_window'       => 900,       // window. Two budgets on purpose: create
    //                                      hashes a password on every call whether or
    //                                      not the space exists, so metering it by
    //                                      failures never trips.
    // 'max_spaces'              => 10000,
