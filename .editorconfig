# Editor and OS conventions. `.gitattributes` normalises line endings for git;
# this file tells the editor what the working tree is supposed to look like.
#
# 4 spaces, LF, UTF-8 — the same shape `.prettierrc.json` asks for and the shape
# the code is already written in.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml,md,webmanifest}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown, and stripping them would
# silently rewrite the document.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab